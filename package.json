{
  "name": "famulus",
  "version": "0.0.0",
  "description": "famulus — Haru の代わりに AI の動向を追い、外に出す文を書く常駐エージェント。governance/memory を Effect で持ち、道具ループを AI SDK に載せる。",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "gate": "tsc --noEmit && biome check . && bun run test:coverage",
    "typecheck": "tsc --noEmit",
    "test": "bunx --bun vitest run",
    "test:coverage": "bunx --bun vitest run --coverage",
    "test:watch": "bunx --bun vitest",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "agent": "bun src/chat.ts",
    "oz": "bun src/cli.ts",
    "fam": "bun src/cli.ts",
    "cycle": "bun src/cycle.ts",
    "evaluate:explore": "bun evaluate/explore.ts",
    "eval:keeper": "bun evaluate/keeper-fidelity.ts",
    "eval:recall": "bun evaluate/recall-miss.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.41",
    "@ai-sdk/provider": "^4.0.7",
    "@valibot/to-json-schema": "^1.7.1",
    "ai": "7.0.62",
    "effect": "4.0.0-rc.109",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
