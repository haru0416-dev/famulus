{
  "name": "open-zero",
  "version": "0.0.0",
  "description": "famulus の governance/memory を Effect で持ち上げ、道具ループを AI SDK に載せる層。推論はサブスク枠(claude -p)のまま。",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "gate": "tsc --noEmit && biome check . && bun test test/",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "agent": "bun src/chat.ts",
    "oz": "bun src/cli.ts",
    "tick": "bun src/tick.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.41",
    "@ai-sdk/provider": "^4.0.7",
    "@valibot/to-json-schema": "^1.7.1",
    "ai": "^7.0.62",
    "effect": "^3.22.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
